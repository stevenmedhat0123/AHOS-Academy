rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function owner() {
      return request.auth != null
        && exists(/databases/$(db)/documents/config/owner)
        && get(/databases/$(db)/documents/config/owner).data.uid == request.auth.uid;
    }
    function active() {
      return request.auth != null
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.x > request.time.toMillis();
    }
    // the first registered account becomes owner; the doc can't be re-created afterwards
    match /config/owner {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /config/lock {
      allow read, write: if owner();
      allow create: if request.auth != null && !exists(/databases/$(db)/documents/config/owner) == false
        && get(/databases/$(db)/documents/config/owner).data.uid == request.auth.uid;
    }
    match /config/app {
      allow read: if true;
      allow write: if owner();
    }
    // one tiny doc everyone polls; owner writes content fields, students may only touch chat fields
    match /config/feed {
      allow read: if owner() || active();
      allow create: if owner() || (active() && request.resource.data.keys().hasOnly(['chat_t','chat_n','chat_u','livechat_t','livechat_n','livechat_u']));
      allow update: if owner() || (active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat_t','chat_n','chat_u','livechat_t','livechat_n','livechat_u']));
    }
    match /tokens/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if owner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if owner();
    }
    match /codes/{id} {
      allow get: if request.auth != null;
      allow list, create, delete: if owner();
      allow update: if owner() || (request.auth != null
        && (resource.data.get('n', 1) == 0 || resource.data.u < resource.data.get('n', 1))
        && request.resource.data.u == resource.data.u + 1
        && request.resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['u','by','at'])
        && request.resource.data.at > request.time.toMillis() - 120000
        && request.resource.data.at < request.time.toMillis() + 120000);
    }
    match /users/{uid} {
      allow read: if owner() || (request.auth != null && request.auth.uid == uid);
      allow write: if owner() || (request.auth != null && request.auth.uid == uid
        && getAfter(/databases/$(db)/documents/codes/$(request.resource.data.cid)).data.by == uid
        && getAfter(/databases/$(db)/documents/codes/$(request.resource.data.cid)).data.at > request.time.toMillis() - 180000
        && request.resource.data.x <= request.time.toMillis() + getAfter(/databases/$(db)/documents/codes/$(request.resource.data.cid)).data.d * 86400000 + 600000);
    }
    // directory: username / phone / uid -> public key (only the owner of the entry can change it)
    match /dir/{id} {
      allow read: if request.auth != null && (active() || owner());
      allow create: if request.auth != null && (active() || owner()) && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // inbox: field name = sender uid, value = last activity time (no message content)
    match /inbox/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && (active() || owner()) && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (active() || owner()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
    }
    // encrypted private messages: only the two participants (the owner cannot read them either)
    match /dm/{cid}/m/{id} {
      allow read: if request.auth != null && (active() || owner()) && request.auth.uid in cid.split('_');
      allow create: if request.auth != null && (active() || owner()) && request.auth.uid in cid.split('_')
        && request.resource.data.f == request.auth.uid && request.resource.data.st == 0;
      allow update: if request.auth != null && (active() || owner()) && request.auth.uid in cid.split('_') && (
        (resource.data.f == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c','ed','de']))
        || (resource.data.f != request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])));
    }
    match /config/board {
      allow read: if owner() || active();
      allow write: if owner();
    }
    // attendance: owner opens a class (code + deadline); a student can create exactly one mark while it is open
    match /config/att {
      allow read, write: if owner();
    }
    match /att/{id} {
      allow read: if owner() || (request.auth != null && id.matches('.*_' + request.auth.uid));
      allow create: if request.auth != null && active() && exists(/databases/$(db)/documents/config/att)
        && id == get(/databases/$(db)/documents/config/att).data.code + '_' + request.auth.uid
        && request.resource.data.code == get(/databases/$(db)/documents/config/att).data.code
        && request.time.toMillis() < get(/databases/$(db)/documents/config/att).data.until;
    }
    // one device per account: created by the student's first device, only the owner can change/unlink
    match /devices/{uid} {
      allow read: if owner() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if owner();
    }
    // PDFs added by the owner (stored in chunks); only the owner writes, active students read
    match /pdfs/{id} {
      allow read: if owner() || active();
      allow write: if owner();
    }
    // assignments: one submission per student per assignment; only the owner can score
    match /subs/{id} {
      allow read: if owner() || (request.auth != null && id.matches('.*_' + request.auth.uid));
      allow create: if request.auth != null && active() && id.matches('.*_' + request.auth.uid) && request.resource.data.u == request.auth.uid;
      allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sc']);
    }
    match /sf/{id} {
      allow read: if owner() || (request.auth != null && id.matches('.*_' + request.auth.uid + '_[0-9]+'));
      allow create: if request.auth != null && active() && id.matches('.*_' + request.auth.uid + '_[0-9]+');
    }
    // group chat: students write only as themselves (server timestamp), only the owner can delete
    match /chats/{id} {
      allow read: if owner() || active();
      allow create: if (owner() || active())
        && request.resource.data.text is string && request.resource.data.sender is string
        && request.resource.data.timestamp == request.time
        && request.resource.data.uid == request.auth.uid
        && (owner() || request.resource.data.o == 0);
      allow update, delete: if owner();
    }
    // quiz results: one doc per student; students can only ADD new quiz keys, never change old scores
    match /results/{uid} {
      allow read: if owner() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid && active();
      allow update: if request.auth != null && request.auth.uid == uid && active()
        && request.resource.data.diff(resource.data).changedKeys().size() == 0
        && request.resource.data.diff(resource.data).removedKeys().size() == 0;
    }
    match /{col}/{id} {
      allow read: if col.matches('s_.*') && (owner() || (col != 's_livechat' && active()));
      allow create: if col.matches('s_.*') && (owner() || ((col == 's_chat' || col == 's_livechat') && active() && request.resource.data.o == 0));
      allow update, delete: if col.matches('s_.*') && owner();
    }
  }
}
