rules_version = '2';
// Firebase Storage rules: only the owner uploads; only the owner and students with an active plan read.
// (Download links of videos also carry a private token that is saved only inside your protected database.)
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file=**} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/config/owner).data.uid == request.auth.uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.x > request.time.toMillis());
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/config/owner).data.uid == request.auth.uid;
    }
  }
}
